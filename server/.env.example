PORT=5000
CLIENT_URL=http://localhost:5173  # exact deployed Vercel origin in production
NODE_ENV=development
MONGO_URI=             # MongoDB Atlas connection string
JWT_SECRET=            # long random string
GOOGLE_CLIENT_ID=      # Google Cloud Console OAuth client ID
SENDER_EMAIL=          # "from" address for outgoing mail
SMTP_HOST=
SMTP_PORT=
SMTP_NAME=
SMTP_PASSWORD=
GEMINI_API_KEY=        # Google AI Studio API key (aistudio.google.com/apikey). Server only, never VITE_
GEMINI_MODEL=          # optional, defaults to gemini-3.8-flash
